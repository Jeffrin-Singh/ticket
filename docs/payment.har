",\r\n\t\t\"HeaderPage.logout\": \"வெளியேறு\",\r\n\t\t\"HeaderPage.lastLogin\": \"உங்கள் கடைசி உள்நுழைவு\",\r\n\t\t\"HeaderPage.myAccount\": \"என் கணக்கு\",\r\n\t\t\"HeaderPage.sed\": \"சிறப்பு நுழைவு தரிசனம்\",\r\n\t\t\"HeaderPage.accom\": \"விடுதி\",\r\n\t\t\"HeaderPage.seva\": \"சேவை\",\r\n\t\t\"HeaderPage.sevaDIP\": \"சேவை மின்னணு DIP \",\r\n\t\t\"HeaderPage.kalyanaVedika\": \"கல்யாண மேடை\",\r\n\t\t\"HeaderPage.publications\": \"வெளியீடுகள்\",\r\n\t\t\"HeaderPage.sapthagiri\": \"ஸப்தகிரி பத்திரிகை\",\r\n\t\t\"HeaderPage.eBooks\": \"இ-புத்தகம்\",\r\n\t\t\"HeaderPage.hundi\": \"உண்டியல்\",\r\n\t\t\"HeaderPage.donation\": \"நன்கொடை\",\r\n\t\t\"HeaderPage.donorManagementSystem\": \"(நன்கொடையாளர் தகவல் மேலாண்மை முறை)\",\r\n\t\t\"HeaderPage.cottageDonors\": \"குடில் நன்கொடையாளர் \",\r\n\t\t\"HeaderPage.cdms\": \"(குடில் நன்கொடையாளர் தகவல் மேலாண்மை முறை)\",\r\n\t\t\"HeaderPage.dms\": \"நன்கொடையாளர் தகவல் மேலாண்மை முறை\",\r\n\t\t\"HeaderPage.darshanDIP\": \"தரிசனம் மின்னணு DIP\",\r\n\t\t\"HeaderPage.transactionHistory\": \"பரிவர்த்தனை வரலாறு\",\r\n\t\t\"HeaderPage.logIn\": \"உள் நுழை\",\r\n\t\t\"Services\": \"சேவைகள்\",\r\n\t\t\"Special Entry Darshan\": \"சிறப்பு நுழைவு தரிசனம்\",\r\n\t\t\"Darshan History\": \"தரிசன வரலாறு\",\r\n\t\t\"Seva\": \"சேவை\",\r\n\t\t\"Seva_History\": \"சேவை வரலாறு\",\r\n\t\t\"Kalyana Vedika\": \"கல்யாண மேடை\",\r\n\t\t\"Kalyana Vedika Bookings\": \"கல்யாண மேடை முன்பதிவு\",\r\n\t\t\"Reset Password\": \"பாஸ்வேர்ட் மீட்டமைக்க\",\r\n\t\t\"Accommodation\": \"விடுதி\",\r\n\t\t\"User Registration\": \"உபயோகிப்போர் பதிவு\",\r\n\t\t\"Sapthagiri_Magazine\": \"ஸப்தகிரி பத்திரிகை\",\r\n\t\t\"Accommodation History\": \"விடுதி வரலாறு\",\r\n\t\t\"AccommodationPDF\": \"விடுதி PDF\",\r\n\t\t\"Hundi\": \"உண்டியல்\",\r\n\t\t\"Hundi_History\": \"உண்டியல் வரலாறு\",\r\n\t\t\"Sapthagiri_History\": \"ஸப்தகிரி வரலாறு\",\r\n\t\t\"Account Activation\": \"கணக்கு செயல்படுத்தல்\",\r\n\t\t\"Seva Electronic DIP History\": \"சேவை மின்னணு DIP வரலாறு\",\r\n\t\t\"SessionSeconds\": \"வினாடிகளில் உங்கள் அமர்வு காலாவதியாகும்\",\r\n\t\t\"SessionOk\": \"சரி\",\r\n\t\t\"SessionEnabtime\": \"அடுத்த \",\r\n\t\t\"feedbackFormPage.feedbackForm\": \"கருத்து வடிவம்\",\r\n\t\t\"feedbackFormPage.name\": \"பெயர்\",\r\n\t\t\"feedbackFormPage.nameValidation\": \"சரியான பெயரை உள்ளிடவும், அதிகபட்ச எழுத்துகள் 80 ஆகும்.\",\r\n\t\t\"feedbackFormPage.validName\": \"சரியான பெயரை உள்ளிடுக.\",\r\n\t\t\"feedbackFormPage.emailId\": \"மின்னஞ்சல் முகவரி\",\r\n\t\t\"feedbackFormPage.validEmailId\": \"சரியான மின்னஞ்சல் முகவரியை உள்ளிடவும்\",\r\n\t\t\"feedbackFormPage.regProcess\": \"பதிவுசெய்தல் செயல்முறை\",\r\n\t\t\"feedbackFormPage.delighted\": \"மகிழ்ச்சியடைகின்றது\",\r\n\t\t\"feedbackFormPage.satisfied\": \"திருப்தி\",\r\n\t\t\"feedbackFormPage.notSatisfied\": \"திருப்தி இல்லை\",\r\n\t\t\"feedbackFormPage.bookingProcess\": \"முன்பதிவு செயல்முறை\",\r\n\t\t\"feedbackFormPage.redemption\": \"(மீட்பு)\",\r\n\t\t\"feedbackFormPage.paymentExp\": \"கட்டணம் அனுபவம்\",\r\n\t\t\"feedbackFormPage.privRedemption\": \"சலுகை மீட்பு\",\r\n\t\t\"feedbackFormPage.commChannel\": \"தொடர்பு சேனல்கள் (எஸ்எம்எஸ், மின்னஞ்சல்)\",\r\n\t\t\"feedbackFormPage.overallWebsiteExp\": \"ஒட்டுமொத்த வலைத்தள அனுபவம்\",\r\n\t\t\"feedbackFormPage.suggestions\": \"ஆலோசனைகள்\",\r\n\t\t\"Arjitha Kalyanotsavam (Sri Chennakesava Swamy Temple, Tallapaka)\": \"Arjitha Kalyanotsavam (Sri Chennakesava Swamy Temple, Tallapaka)\",\r\n\t\t\"feedbackFormPage.validSuggestion\": \"தயவுசெய்து சரியான பரிந்துரையை உள்ளிடவும், அனுமதிக்கப்பட்ட அதிகபட்ச எழுத்துகள் 1000.\",\r\n\t\t\"feedbackFormPage.reset\": \"மீட்டமை\",\r\n\t\t\"feedbackFormPage.submit\": \"சமர்ப்பி\",\r\n\t\t\"My Account\": \"என் கணக்கு\",\r\n\t\t\"January\": \"ஜனவரி\",\r\n\t\t\"February\": \"பிப்ரவரி\",\r\n\t\t\"March\": \"மார்ச்\",\r\n\t\t\"April\": \"ஏப்ரல்\",\r\n\t\t\"May\": \"மே\",\r\n\t\t\"June\": \"ஜூன்\",\r\n\t\t\"July\": \"ஜூலை\",\r\n\t\t\"August\": \"ஆகஸ்ட்\",\r\n\t\t\"September\": \"செப்டம்பர்\",\r\n\t\t\"October\": \"அக்டோபர்\",\r\n\t\t\"November\": \"நவம்பர்\",\r\n\t\t\"December\": \"டிசம்பர்\",\r\n\t\t\"Seva Electronic DIP\": \"சேவை மின்னணு DIP \",\r\n\t\t\"Seva DIP Result\": \"சேவை DIP முடிவு\",\r\n\t\t\"mon\": \"ஞா\",\r\n\t\t\"tue\": \"தி\",\r\n\t\t\"wed\": \"செ\",\r\n\t\t\"thu\": \"பு\",\r\n\t\t\"fri\": \"வி\",\r\n\t\t\"sat\": \"வெ\",\r\n\t\t\"sun\": \"ச\",\r\n\t\t\"ATC CAR PARKING AREA\": \"ATC கார் பார்க்கிங் பகுதி\",\r\n\t\t\"ATC Circle\": \"ATC Circle\",\r\n\t\t\"ATC Circle, Tirumala\": \"ATC Circle, Tirumala\",\r\n\t\t\"Archanananthara Darshanam\": \"அர்ச்சனானந்தர தரிசனம்\",\r\n\t\t\"Prathyeka Kalyanotsavam\": \"பிரத்தியேக கல்யாணொட்சவம்\",\r\n\t\t\"Suprabhatam\": \"சுப்ரபாதம்\",\r\n\t\t\"Nijapada Darshanam\": \"நிஜபத தரிசனம்\",\r\n\t\t\"Thomala Seva\": \"தோமாலை சேவை\",\r\n\t\t\"Archana\": \"அர்ச்சனை\",\r\n\t\t\"Visesha Pooja\": \"விசேஷ பூஜை\",\r\n\t\t\"Astadala Pada Padmaradhanamu\": \"அஷ்டதள பட பத்மராதனமு \",\r\n\t\t\"Sahasra Kalasabhishekam\": \"சகஸ்ர கலசாபிஷேகம்\",\r\n\t\t\"Tiruppavadai\": \"திருப்பாவாடை \",\r\n\t\t\"Kalyanotsavam\": \"கல்யாணோட்சவம் \",\r\n\t\t\"Abhishekam to Sri Vedavalli Ammavaru (Sri VST, Nagalapuram)\":\"ஸ்ரீ வேதவல்லி அம்மாவாருக்கு (ஸ்ரீ விஎஸ்டி, நாகலாபுரம்) அபிஷேகம்\",\r\n\t\t\"Vasanthotsavam\": \"வசந்தோத்சவம் \",\r\n\t\t\"Unjal Seva\": \"ஊஞ்சல் சேவை  \",\r\n\t\t\"Sahasra Deepalankara Seva\": \"சஹஸ்ர தீபாலன்கார சேவை\",\r\n\t\t\"Arjitha Brahmotsavam\": \"ஆர்ஜித ப்ரஹ்மோத்சவம் \",\r\n\t\t\"Varalakshmi Vratham (Sri PAT, Tiruchanoor)\": \"வரலக்ஷ்மி  விரதம் (ஸ்ரீ PAT, திருச்சானூர்)\",\r\n\t\t\"PAN CARD\": \"பான் அட்டை\",\r\n\t\t\"RATION CARD\": \"ரேஷன் அட்டை\",\r\n\t\t\"PASSPORT ID\": \"பாஸ்போர்ட் அடையாளம்\",\r\n\t\t\"DRIVING LICENSE\": \"ஓட்டுனர் உரிமம்\",\r\n\t\t\"AADHAR CARD\": \"ஆதார் அட்டை\",\r\n\t\t\"AadharCard\": \"ஆதார்அட்டை\",\r\n\t\t\"VOTER ID\": \"வாக்காளர் ​அடையாளம்\",\r\n\t\t\"Supatham Entry\": \"சுபாதம் நுழைவு\",\r\n\t\t\"Vaibhavotsava Mandapam\": \"வைபவோட்ஸவா மண்டபம் \",\r\n\t\t\"S.D. Mandapam\": \"சஹஸ்ர தீபலன்கரணை மண்டபம்\",\r\n\t\t\"VQC-1\": \"வைகுண்டம் வரிசை வளாகம் - 1\",\r\n\t\t\"Asthana Mandapam, besides Sri PAT, Tiruchanoor\": \"ஆஸ்தான மண்டபம்,  ஸ்ரீ PAT தவிர, திருச்சானூர்\",\r\n\t\t\"1. The reporting point for availing Seva is at Vaibhavotsava Mandapam, Tirumala.\": \"1. சேவாவைப் பெற்றுக் கொள்வதற்கான அறிக்கையானது வைபவோட்ஸவ மண்டபம், திருமலையில் உள்ளது.\",\r\n\t\t\"1. The reporting point for availing Seva is at Supatham Entry, Tirumala.\": \"1. சேவாவைப் பெற்றுக் கொள்வதற்கான அறிக்கையானது  சுபாதம் நுழைவு, திருமலையில் உள்ளது.\",\r\n\t\t\"1. The reporting point for availing Seva is at S.D. Mandapam, Tirumala.\": \"1. சேவாவைப் பெற்றுக் கொள்வதற்கான அறிக்கையானது சஹஸ்ர தீபலன்கரணை மண்டபம், திருமலையில் உள்ளது.\",\r\n\t\t\"1. The reporting point for availing Seva is at VQC-1, Tirumala.\": \"1.  சேவாவைப் பெற்றுக் கொள்வதற்கான அறிக்கையானது வைகுண்டம் வரிசை வளாகம் - 1, திருமலையில் உள்ளது.\",\r\n\t\t\"1. The reporting point for availing Seva is at Asthana Mandapam, besides Sri PAT, Tiruchanoor.\": \"1. சேவாவைப் பெறுவதற்கான அறிக்கை புள்ளி - ஆஸ்தான மண்டபம்,  ஸ்ரீ PAT தவிர, திருச்சானூர்.\",\r\n\t\t\"1. The reporting point for availing Seva is at Sri Chennakesava Swamy Temple Office , Tallapaka.\":\"1. The reporting point for availing Seva is at Sri Chennakesava Swamy Temple Office , Tallapaka.\",\r\n\t\t\"2 Small Laddus\": \"சிறிய லட்டுகள்\",\r\n\t\t\"Male\": \"ஆ\",\r\n\t\t\"Female\": \"பெ\",\r\n\t\t\"M\": \"ஆ\",\r\n\t\t\"F\": \"பெ\",\r\n\t\t\"Tirumala\": \"திருமலை \",\r\n\t\t\"Tirupati\": \"திருப்பதி \",\r\n\t\t\"Srinivasam\": \"ஸ்ரீனிவாசம்\",\r\n\t\t\"Madhavam\": \"மாதவம் \",\r\n\t\t\"Vishnu Nivasam\": \"விஷ்ணு நிவாஸம் \",\r\n\t\t\"Donation\": \"நன்கொடை\",\r\n\t\t\"Diaries/Calendars/Panchangam\": \"நாட்குறிப்புகள் / நாள்காட்டி / பஞ்சாங்கம்\",\r\n\t\t\"Sri Chennakesava Swamy Temple Office\": \"Sri Chennakesava Swamy Temple Office\",\r\n\t\t\"Suprabhatham (Sri PAT, Tiruchanoor)\": \"Suprabhatham (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Kalyanotsavam (Sri PAT, Tiruchanoor)\": \"Kalyanotsavam (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Astadala Pada Pa