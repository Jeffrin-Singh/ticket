          "content": {
            "size": 130470,
            "mimeType": "application/json",
            "text": "{\r\n\t\"Kannada\": {\r\n\r\n\t\t\"FooterPage.copyright\": \"ಕೃತಿಸ್ವಾಮ್ಯ\",\r\n\t\t\"FooterPage.rights\": \"ತಿರುಮಲ ತಿರುಪತಿ ದೇವಸ್ಥಾನಗಳು - ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.\",\r\n\t\t\"FooterPage.terms\": \"ನಿಯಮಗಳು ಮತ್ತು ಷರತ್ತುಗಳು\",\r\n\t\t\"FooterPage.guidelines\": \"ಮಾರ್ಗದರ್ಶನಗಳು ಮತ್ತು ಪ್ರಶ್ನೆಗಳು\",\r\n\t\t\"FooterPage.feedback\": \"ಪ್ರತಿಕ್ರಿಯೆ\",\r\n\t\t\"FooterPage.contactUs\": \"ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ\",\r\n\t\t\"HeaderPage.welcome\": \"ಸ್ವಾಗತ,\",\r\n\t\t\"HeaderPage.logout\": \"ಲಾಗ್ಔಟ್\",\r\n\t\t\"HeaderPage.lastLogin\": \"ನಿಮ್ಮ ಕೊನೆಯ ಲಾಗಿನ್\",\r\n\t\t\"HeaderPage.myAccount\": \"ನನ್ನ ಖಾತೆ\",\r\n\t\t\"HeaderPage.sed\": \"ವಿಶೇಷ ಪ್ರವೇಶ ದರ್ಶನ\",\r\n\t\t\"HeaderPage.accom\": \"ವಸತಿ\",\r\n\t\t\"HeaderPage.seva\": \"ಸೇವೆ\",\r\n\t\t\"HeaderPage.sevaDIP\": \"ಸೇವೆ ಎಲೆಕ್ಟ್ರಾನಿಕ್ DIP\",\r\n\t\t\"HeaderPage.kalyanaVedika\": \"ಕಲ್ಯಾಣ ವೇದಿಕೆ\",\r\n\t\t\"HeaderPage.publications\": \"ಪ್ರಕಟಣೆಗಳು\",\r\n\t\t\"HeaderPage.sapthagiri\": \"ಸಪ್ತಗಿರಿ ಪತ್ರಿಕೆ\",\r\n\t\t\"HeaderPage.eBooks\": \"ಈ - ಪುಸ್ತಕಗಳು\",\r\n\t\t\"HeaderPage.hundi\": \"ಹುಂಡಿ\",\r\n\t\t\"HeaderPage.donation\": \"ದೇಣಿಗೆ\",\r\n\t\t\"HeaderPage.donorManagementSystem\": \"(ದೇಣಿಗೆ ನಿರ್ವಹಣೆ ವ್ಯವಸ್ಥೆ)\",\r\n\t\t\"HeaderPage.cottageDonors\": \"ಕಾಟೇಜ್ ದಾನಿಗಳು\",\r\n\t\t\"HeaderPage.cdms\": \"(ಕಾಟೇಜ್ ದಾನಿಗಳ ನಿರ್ವಹಣಾ ವ್ಯವಸ್ಥೆ)\",\r\n\t\t\"HeaderPage.dms\": \"ದೇಣಿಗೆ ನಿರ್ವಹಣೆ ವ್ಯವಸ್ಥೆ\",\r\n\t\t\"HeaderPage.darshanDIP\": \"ದರ್ಶನ ಎಲೆಕ್ಟ್ರಾನಿಕ್ DIP\",\r\n\t\t\"HeaderPage.transactionHistory\": \"ವ್ಯವಹಾರಗಳ ವಿವರಗಳು\",\r\n\t\t\"HeaderPage.logIn\": \"ಲಾಗಿನ್\",\r\n\t\t\"Special Entry Darshan\": \"ವಿಶೇಷ ಪ್ರವೇಶ ದರ್ಶನ\",\r\n\t\t\"Services\": \"ಸೇವೆಗಳು\",\r\n\t\t\"Accommodation\": \"ವಸತಿ\",\r\n\t\t\"User Registration\": \"ಭಕ್ತದಿಗಳ ನೋಂದಣಿ \",\r\n\t\t\"Donation\": \"ದೇಣಿಗೆ\",\r\n\t\t\"Hundi\": \"ಹುಂಡಿ\",\r\n\t\t\"Seva_History\": \"ಸೇವೆ ವ್ಯವಹಾರಗಳು\",\r\n\t\t\"Kalyana Vedika\": \"ಕಲ್ಯಾಣ ವೇದಿಕೆ\",\r\n\t\t\"Kalyana Vedika Bookings\": \"ಕಲ್ಯಾಣ ವೇದಿಕ ಬುಕಿಂಗ್\",\r\n\t\t\"Reset Password\": \"ಪಾಸ್ವರ್ಡ್ ಮರುಹೊಂದಿಸಿ\",\r\n\t\t\"Sapthagiri\": \"ಸಪ್ತಗಿರಿ ಪತ್ರಿಕೆ\",\r\n\t\t\"Sapthagiri_Magazine\": \"ಸಪ್ತಗಿರಿ ಪತ್ರಿಕೆ\",\r\n\t\t\"SessionSeconds\": \"ನಿಮಿಷಗಳು\",\r\n\t\t\"SessionOk\": \"ಸರಿ\",\r\n\t\t\"SessionEnabtime\": \"ನಿಮ್ಮ ಅಧಿವೇಶನವು ಮುಂದಿನ ಅವಧಿ ಮುಗಿಯುತ್ತದೆ\",\r\n\t\t\"feedbackFormPage.feedbackForm\": \"ಪ್ರತಿಕ್ರಿಯೆ ಪುಟ\",\r\n\t\t\"feedbackFormPage.name\": \"ಹೆಸರು\",\r\n\t\t\"feedbackFormPage.nameValidation\": \"ದಯವಿಟ್ಟು ಸರಿಯಾದ  ಹೆಸರನ್ನು ನಮೂದಿಸಿ, ನಮೂದಿಸಲಾದ ಗರಿಷ್ಠ ಅಕ್ಷರಗಳು 80.\",\r\n\t\t\"feedbackFormPage.validName\": \"ದಯವಿಟ್ಟು ಸರಿಯಾದ ಹೆಸರನ್ನು ನಮೂದಿಸಿ .\",\r\n\t\t\"feedbackFormPage.emailId\": \"ಇಮೇಲ್ ಐಡಿ\",\r\n\t\t\"feedbackFormPage.validEmailId\": \"ದಯವಿಟ್ಟು ಸರಿಯಾದ  ಇಮೇಲ್ ಐಡಿಯನ್ನು ನಮೂದಿಸಿ\",\r\n\t\t\"feedbackFormPage.regProcess\": \"ನೋಂದಣಿ ಪ್ರಕ್ರಿಯೆ\",\r\n\t\t\"feedbackFormPage.delighted\": \"ಸಂತೋಷ\",\r\n\t\t\"feedbackFormPage.satisfied\": \"ಸಂಪೂರ್ಣವಾಗಿ ತೃಪ್ತಿ\",\r\n\t\t\"feedbackFormPage.notSatisfied\": \"ಸಂಪೂರ್ಣವಾಗಿ ತೃಪ್ತಿ ಇಲ್ಲ\",\r\n\t\t\"feedbackFormPage.bookingProcess\": \"ಬುಕಿಂಗ್ ಪ್ರಕ್ರಿಯೆ\",\r\n\t\t\"feedbackFormPage.redemption\": \"(ಹಿಂತಿರುಗಿ)\",\r\n\t\t\"feedbackFormPage.paymentExp\": \"ಪಾವತಿ ಅನುಭವ\",\r\n\t\t\"feedbackFormPage.privRedemption\": \"ಪ್ರಿವಿಲೇಜ್ ರಿಡೆಂಪ್ಶನ್\",\r\n\t\t\"feedbackFormPage.commChannel\": \"ಸ೦ಪರ್ಕಗಳ SMS, ಇಮೇಲ್ ಮೂಕ್ತಾರ\",\r\n\t\t\"feedbackFormPage.overallWebsiteExp\": \"ಒಟ್ಟಾರೆ ವೆಬ್ಸೈಟ್ ಅನುಭವ\",\r\n\t\t\"feedbackFormPage.suggestions\": \"ಸಲಹೆಗಳು\",\r\n\t\t\"feedbackFormPage.validSuggestion\": \"ದಯವಿಟ್ಟು ಸರಿಯಾದ ಸಲಹೆಯನ್ನು ನಮೂದಿಸಿ,ನಮೂದಿಸಲಾದ ಗರಿಷ್ಠ ಅಕ್ಷರಗಳು 1000.\",\r\n\t\t\"feedbackFormPage.reset\": \"ಮರುಹೊಂದಿಸಿ\",\r\n\t\t\"feedbackFormPage.submit\": \"ಸಲ್ಲಿಸಲು\",\r\n\t\t\"Seva\": \"ಸೇವೆ\",\r\n\t\t\"mon\": \"ಸೋಮ\",\r\n\t\t\"tue\": \"ಮಂಗಳ\",\r\n\t\t\"wed\": \"ಬುಧ\",\r\n\t\t\"thu\": \"ಗುರು\",\r\n\t\t\"fri\": \"ಶುಕ್ರ\",\r\n\t\t\"sat\": \"ಶನಿ\",\r\n\t\t\"sun\": \"ಭಾನು\",\r\n\t\t\"My Account\": \"ನನ್ನ ಖಾತೆ\",\r\n\t\t\"AadharCard\": \"ಆಧಾರ್ಕಾರ್ಡ್\",\r\n\t\t\"January\": \"ಜನವರಿ\",\r\n\t\t\"February\": \"ಫೆಬ್ರುವರಿ\",\r\n\t\t\"March\": \"ಮಾರ್ಚ್\",\r\n\t\t\"April\": \"ಏಪ್ರಿಲ್\",\r\n\t\t\"May\": \"ಮೇ\",\r\n\t\t\"June\": \"ಜೂನ್\",\r\n\t\t\"July\": \"ಜುಲೈ\",\r\n\t\t\"August\": \"ಆಗಸ್ಟ್\",\r\n\t\t\"September\": \"ಸೆಪ್ಟೆಂಬರ್\",\r\n\t\t\"October\": \"ಅಕ್ಟೋಬರ್\",\r\n\t\t\"November\": \"ನವೆಂಬರ್\",\r\n\t\t\"December\": \"ಡಿಸೆಂಬರ್\",\r\n\t\t\"Seva Electronic DIP\": \"ಸೇವೆ ಎಲೆಕ್ಟ್ರಾನಿಕ್ DIP\",\r\n\t\t\"Seva DIP Result\": \"ಸೇವೆ DIP ಫಲಿತಾಂಶ\",\r\n\t\t\"ATC CAR PARKING AREA\": \"ATC ಕಾರ್ ಪಾರ್ಕಿಂಗ್ ಪ್ರದೇಶ\",\r\n\t\t\"Archanananthara Darshanam\": \"ಅರ್ಚನಾ ಅನಂತ ದರ್ಶನ\",\r\n\t\t\"Prathyeka Kalyanotsavam\": \"ಪ್ರಥೈಕೆ ಕಲ್ಯಾಣೋತ್ಸವಂ\",\r\n\t\t\"Suprabhatam\": \"ಸುಪ್ರಾಭತಮ್\",\r\n\t\t\"Nijapada Darshanam\": \"ನಿಜಪದ ದರ್ಶನಮ್\",\r\n\t\t\"Thomala Seva\": \"ಥಾಮಲಾ ಸೇವೆ\",\r\n\t\t\"Archana\": \"ಅರ್ಚನಾ\",\r\n\t\t\"Visesha Pooja\": \"ವಿಶೇಶ ಪೂಜಾ\",\r\n\t\t\"Astadala Pada Padmaradhanamu\": \"ಅಸ್ತದಾಲ ಪಾಡಾ ಪದ್ಮರನಾಥಮು\",\r\n\t\t\"Sahasra Kalasabhishekam\": \"ಸಹಸ್ರ ಕಲಸಾಭಿಷೇಕಂ\",\r\n\t\t\"Tiruppavadai\": \"ತಿರುಪ್ಪಪಾಡೈ\",\r\n\t\t\"Kalyanotsavam\": \"ಕಲ್ಯಾಣೋತ್ಸವಂ\",\r\n\t\t\"Pavithrotsavam\":\"Pavithrotsavam\",\r\n\t\t\"Abhishekam to Sri Vedavalli Ammavaru (Sri VST, Nagalapuram)\":\"ಶ್ರೀ ವೇದವಲ್ಲಿ ಅಮ್ಮನವರಿಗೆ (ಶ್ರೀ VST, ನಾಗಲಾಪುರಂ) ಅಭಿಷೇಕ\",\r\n\t\t\"Vasanthotsavam\": \"ವಸಂತೋತ್ಸವಂ\",\r\n\t\t\"Unjal Seva\": \"ಉಂಜಲ್ ಸೇವೆ\",\r\n\t\t\"Sahasra Deepalankara Seva\": \"ಸಹಸ್ರಾ ದೀಪಲಂಕರ ಸೇವೆ\",\r\n\t\t\"Arjitha Brahmotsavam\": \"ಅರ್ಜಿತಾ ಬ್ರಹ್ಮೋತ್ಸವಂ\",\r\n\t\t\"Varalakshmi Vratham (Sri PAT, Tiruchanoor)\": \"ವರಲಕ್ಷ್ಮಿ  ವ್ರತಂ  (ಶ್ರೀ  PAT,ತಿರುಚನೂರ್)\",\r\n\t\t\"PAN CARD\": \"ಪ್ಯಾನ್ ಕಾರ್ಡ್\",\r\n\t\t\"RATION CARD\": \"ರೇಷನ್ ಕಾರ್ಡ್\",\r\n\t\t\"PASSPORT ID\": \"ಪಾಸ್ಪೋರ್ಟ್ ಐಡಿ\",\r\n\t\t\"DRIVING LICENSE\": \"ಚಾಲನಾ ಪರವಾನಿಗೆ\",\r\n\t\t\"AADHAR CARD\": \"ಆಧಾರ್ ಕಾರ್ಡ್\",\r\n\t\t\"VOTER ID\": \"ಮತದಾರ ಐಡಿ\",\r\n\t\t\"Supatham Entry\": \"ಸುಪಥಮ್ ಎಂಟ್ರಿ\",\r\n\t\t\"Vaibhavotsava Mandapam\": \"ವೈಭೋತ್ಸವ ಮಂಡಪಮ್\",\r\n\t\t\"S.D. Mandapam\": \"S.D. ಮಂಡಪಮ್\",\r\n\t\t\"VQC-1\": \"ವೈಕುಂಠಮ್ ಕ್ಯೂ ಕಾಂಪ್ಲೆಕ್ಸ್-1\",\r\n\t\t\"ATC Circle\": \"ATC Circle\",\r\n\t\t\"ATC Circle, Tirumala\": \"ATC Circle, Tirumala\",\r\n\t\t\"Asthana Mandapam, besides Sri PAT, Tiruchanoor\": \"ಆಸ್ಥಾನ  ಮಂಡಪಂ ,  ಶ್ರೀ  PAT ಪಕ್ಕದಲ್ಲಿ, ತಿರುಚನೂರ್\",\r\n\t\t\"1. The reporting point for availing Seva is at Vaibhavotsava Mandapam, Tirumala.\": \"1. ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವು ವೈಭವೋತ್ಸವ ಮಂಡಪಮ್, ತಿರುಮಲದಲ್ಲಿದೆ.\",\r\n\t\t\"1. The reporting point for availing Seva is at Supatham Entry, Tirumala.\": \"1. ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವು ಸುಮತಂ ಎಂಟ್ರಿ, ತಿರುಮಲದಲ್ಲಿದೆ.\",\r\n\t\t\"1. The reporting point for availing Seva is at S.D. Mandapam, Tirumala.\": \"1.  ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಅಂಶವು S.D ಯಲ್ಲಿದೆ. ಮಂಡಪಂ, ತಿರುಮಲ.\",\r\n\t\t\"1. The reporting point for availing Seva is at VQC-1, Tirumala.\": \"1. ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ವರದಿಯು ತಿರುಮಲ ವೈಕುಂಠಮ್ ಕ್ಯೂ ಕಾಂಪ್ಲೆಕ್ಸ್-1 ನಲ್ಲಿದೆ.\",\r\n\t\t\"1. The reporting point for availing Seva is at Asthana Mandapam, besides Sri PAT, Tiruchanoor.\": \"1. ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಅಂಶವು - ಆಸ್ಥಾನ  ಮಂಡಪಂ ,  ಶ್ರೀ  PAT  ಪಕ್ಕದಲ್ಲಿ, ತಿರುಚನೂರ್.\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kapileswara Swamy Vari Temple, Tirupati\": \"1.The reporting point for availing Seva is Sri kapileswara Swamy Vari Temple, Tirupati\",\r\n\t\t\"1. The reporting point for availing Seva is at Sri Chennakesava Swamy Temple Office , Tallapaka.\":\"1. The reporting point for availing Seva is at Sri Chennakesava Swamy Temple Office , Tallapaka.\",\r\n\t\t\"2 Small Laddus\": \"2 ಸಣ್ಣ ಲಾಡ್ಡುಗಳು\",\r\n\t\t\"Male\": \"ಪುರುಷ\",\r\n\t\t\"Female\": \"ಸ್ತ್ರೀ\",\r\n\t\t\"M\": \"ಪುರುಷ\",\r\n\t\t\"F\": \"ಸ್ತ್ರೀ\",\r\n\t\t\"Tirumala\": \"ತಿರುಮಲ\",\r\n\t\t\"Tirupati\": \"ತಿರುಪತಿ\",\r\n\t\t\"Srinivasam\": \"ಶ್ರೀನಿವಾಸಂ\",\r\n\t\t\"Madhavam\": \"ಮಾಧವಂ\",\r\n\t\t\"Vishnu Nivasam\": \"ವಿಷ್ಣು ನಿವಾಸಮ್ \",\r\n\t\t\"Accommodation History\": \"ವಸತಿ ವ್ಯವಹಾರಗಳು\",\r\n\t\t\"AccommodationPDF\": \"ವಸತಿ ಪಿಡಿಎಫ್\",\r\n\t\t\"Hundi_History\": \"ಹುಂಡಿ ವ್ಯವಹಾರಗಳು\",\r\n\t\t\"Sapthagiri_History\": \"ಸಪ್ತಗಿರಿ ವ್ಯವಹಾರಗಳು\",\r\n\t\t\"Arjitha Kalyanotsavam (Sri Chennakesava Swamy Temple, Tallapaka)\": \"Arjitha Kalyanotsavam (Sri Chennakesava Swamy Temple, Tallapaka)\",\r\n\t\t\"Account Activation\": \"ಖಾತೆ ಸಕ್ರಿಯಗೊಳಿಸುವಿಕೆ\",\r\n\t\t\"Seva Electronic DIP History\": \"ಸೇವೆ ಎಲೆಕ್ಟ್ರಾನಿಕ್ DIP ವ್ಯವಹಾರಗಳು\",\r\n\t\t\"Darshan History\": \"ದರ್ಶನ ವ್ಯವಹಾರಗಳು\",\r\n\t\t\"Diaries/Calendars/Panchangam\": \"ಡೈರಿಗಳು / ಕ್ಯಾಲೆಂಡರ್ಗಳು / ಪಂಚಾಂಗಂ\",\r\n\t\t\"Suprabhatham (Sri PAT, Tiruchanoor)\": \"Suprabhatham (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Laksha Kumkumarchana,Tiruchanoor (Sri PAT, Tiruchanoor)\":\"Laksha Kumkumarchana,Tiruchanoor (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Laksha Kumkumarchana,Tiruchanoor (Online Participation)\":\"Laksha Kumkumarchana,Tiruchanoor (Online Participation)\",\r\n\t\t\"Kalyanotsavam (Sri PAT, Tiruchanoor)\": \"Kalyanotsavam (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Astadala Pada Padmaradhanam (Sri PAT, Tiruchanoor)\": \"Astadala Pada Padmaradhanam (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Tiruppavada (Sri PAT, Tiruchanoor)\": \"Tiruppavada (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Vastralankara Seva (Sri PAT, Tiruchanoor)\": \"Vastralankara Seva (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Abhishekam (Sri PAT, Tiruchanoor)\": \"Abhishekam (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Lakshmi Puja (Sri PAT, Tiruchanoor)\": \"Lakshmi Puja (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Pushpanjali Seva (Sri PAT, Tiruchanoor)\": \"Pushpanjali Seva (Sri PAT, Tiruchanoor)\",\r\n\t\t\"Astothara Satakalasabhishekam (Sri PAT, Tiruchanoor)\": \"Astothara Satakalasabhishekam (Sri PAT, Tiruchanoor)\",\r\n\t\t\"In front of the temple, Tiruchanoor\": \"In front of the temple, Tiruchanoor\",\r\n\t\t\"1. The reporting point for availing Seva is at In front of the temple, Tiruchanoor.\": \"1. The reporting point for availing Seva is at In front of the temple, Tiruchanoor.\",\r\n\t\t\"Suprabhatham (Sri GT, Tirupathi)\": \"ಸುಪ್ರಭಾತ (ಶ್ರೀ  ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Thomala Seva (Sri GT, Tirupathi)\": \"ತೋಮಾಲ ಸೇವ (ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Sahasranama Archana (Sri GT, Tirupathi)\": \"ಸಹಸ್ರನಾಮ ಅರ್ಚನೆ  (ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Archana Anantha Darshana (Sri GT, Tirupathi)\": \" ಅರ್ಚನಾ ಅನಂತ ದರ್ಶನ (ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Ekanta Seva (Sri GT, Tirupathi)\": \"ಏಕಾಂತ ಸೇವೆ (ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Unjal Seva (Sri GT, Tirupathi)\": \"ಉಂಜಲ ಸೇವೆ(ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Unjal Seva (Uttra Nakshatram, Sri GT, Tirupathi)\": \"ಉಂಜಲ ಸೇವೆ (ಉತ್ತರ ನಕ್ಷತ್ರ, ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Unjal Seva (Rohini Nakshatram, Sri GT, Tirupathi)\": \"ಉಂಜಲ ಸೇವೆ  (ರೋಹಿಣಿ ನಕ್ಷತ್ರ, ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Unjal Seva (Sravana Nakshatram, Sri GT, Tirupathi)\": \"ಉಂಜಲ ಸೇವೆ (ಶ್ರವಣ ನಕ್ಷತ್ರ, ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Pavithrotsavam (Sri GT, Tirupathi)\": \"ಪವಿತ್ರೋತ್ಸವ (ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Pushpayagam (Sri GT, Tirupathi)\": \"ಪುಷ್ಪಯಗ (ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Sri Chennakesava Swamy Temple Office\": \"Sri Chennakesava Swamy Temple Office\",\r\n\t\t\"Vahana Seva(Morning Brahmotsavams, Sri GT, Tirupathi)\": \"ವಹನ ಸೇವೆ ( ಮುಂಚಾನೆಯ  ಬ್ರಹ್ಮೋತ್ಸವ, ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Vahana Seva(Evening Brahmotsavams, Sri GT, Tirupathi)\": \"ವಹನ ಸೇವೆ  (ಸಂಧ್ಯಾಕಾಲದ  ಬ್ರಹ್ಮೋತ್ಸವ, ಶ್ರೀ ಜಿಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Vastralankarana Seva (Sri P.V.S.T,Appalayagunta)\": \"ವಸ್ತ್ರಾಲಂಕಾರ ಸೇವೆ  (ಶ್ರೀ ಪಿ.ವಿ.ಎಸ್.ಟಿ, ಅಪ್ಪಲಾಯಗುಂಟ) \",\r\n\t\t\"Abhishekam to Moolavarlu (Sri P.V.S.T,Appalayagunta)\": \"ಮೂಲಾವರ್ಲುಗೆ ಅಭಿಷೇಕ (ಶ್ರೀ ಪಿ.ವಿ.ಎಸ್.ಟಿ, ಅಪ್ಪಲಾಯಗುಂಟ)\",\r\n\t\t\"Kalyanotsavam (Sri P.V.S.T,Appalayagunta)\": \" ಕಲ್ಯಾಣೋತ್ಸವಂ (ಶ್ರೀ ಪಿ.ವಿ.ಎಸ್.ಟಿ, ಅಪ್ಪಲಾಯಗುಂಟ)\",\r\n\t\t\"Astadala Pada Padmaradhana (Sri P.V.S.T,Appalayagunta)\": \"ಅಷ್ಟದಳ ಪಾದ ಪದ್ಮಾರಾಧನೆ (ಶ್ರೀ ಪಿ.ವಿ.ಎಸ್.ಟಿ, ಅಪ್ಪಲಾಯಗುಂಟ)\",\r\n\t\t\"Asthothara sata kalasabhishekam (Sri P.V.S.T,Appalayagunta)\": \"ಅಷ್ಟೋತ್ತರ ಶತ  ಕಲಶಾಭಿಷೇಕ    (ಶ್ರೀ ಪಿ.ವಿ.ಎಸ್.ಟಿ, ಅಪ್ಪಲಾಯಗುಂಟ) \",\r\n\t\t\"Arjitha Kalyanotsavam (Brahmotsavams, Sri P.V.S.T,Appalayagunta)\": \"ಅರ್ಜಿತ ಕಲ್ಯಾಣೋತ್ಸವಂ (ಬ್ರಹ್ಮೋತ್ಸವ, ಶ್ರೀ ಪಿ.ವಿ.ಎಸ್.ಟಿ, ಅಪ್ಪಲಾಯಗುಂಟ)\",\r\n\t\t\"Abhishekam to Moolavarlu (Sri S.N.S.T, Tiruchanoor)\": \"ಮೂಲಾವರ್ಲುಗೆ ಅಭಿಷೇಕ (ಶ್ರೀ ಎಸ್.ಎನ್.ಎಸ್.ಟಿ, ತಿರುಚಾನೂರು)\",\r\n\t\t\"Abhishekam to Moolavarlu (Srinivasa Temple,Tiruchanoor)\": \" ಮೂಲಾವರ್ಲುಗೆ ಅಭಿಷೇಕ (ಶ್ರೀನಿವಾಸ ದೇವಸ್ಥಾನ , ತಿರುಚಾನೂರು)\",\r\n\t\t\"Kalyana kankanam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ಕಲ್ಯಾಣ ಕಂಕಣ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ) \",\r\n\t\t\"kalyanotsavam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ಕಲ್ಯಾಣೋತ್ಸವಂ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ,ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ ) \",\r\n\t\t\"Veda Asirvachanam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \" ವೇದ ಆಶಿರ್ವಾದ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Swarna Pushpaarchana (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \" ಸ್ವರ್ಣ ಪುಷ್ಪಾರ್ಚನೆ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Astothara Satha Kalasabishekam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ಅಷ್ಟೋತ್ತರ ಶತ  ಕಲಶಾಭಿಷೇಕ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Thiruppavada (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ತಿರುಪ್ಪಾವಡ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Abhishekam to Moolavaru (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ಮೂಲಾವರ್ಲುಗೆ ಅಭಿಷೇಕ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Vasthralankara Seva (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \" ವಸ್ತ್ರಾಲಂಕಾರ ಸೇವೆ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Unjal Seva(Sravana Nakshatram, Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \" ಉಂಜಲ ಸೇವೆ ( ಶ್ರವಣ ನಕ್ಷತ್ರ,  ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Unjal Seva(Pournami, Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \" ಉಂಜಲ ಸೇವೆ ( ಪೌರ್ಣಮಿ,  ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Pavithrotsavam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram)\": \"ಪವಿತ್ರೋತ್ಸವ (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Pushpayagam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ಪುಷ್ಪಯಗ  (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Vasantotsavam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram)\": \"ವಸಂತೋತ್ಸವ  (ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ)\",\r\n\t\t\"Abhisekham (Sri KRST, Vontimitta)\": \"ಅಭಿಷೇಕ  (ಶ್ರೀ  ಕೆ.ಆರ್.ಎಸ್. ಟಿ   , ವೊಂಟಿಮಿಟ್ಟ)\",\r\n\t\t\"Kalyanotsavam (Sri KRST, Vontimitta)\": \"ಕಲ್ಯಾಣೋತ್ಸವಂ (ಶ್ರೀ  ಕೆ.ಆರ್.ಎಸ್. ಟಿ, ವೊಂಟಿಮಿಟ್ಟ) \",\r\n\t\t\"Anthralaya Darshan (Sri KRST, Vontimitta)\": \"ಆಂಥ್ರಾಲಯ ದರ್ಶನ (ಶ್ರೀ  ಕೆ.ಆರ್.ಎಸ್. ಟಿ, ವೊಂಟಿಮಿಟ್ಟ)\",\r\n\t\t\"Archana Harathi (Sri KRST, Vontimitta)\": \"ಅರ್ಚನಾ    ಆರಾತಿ  (ಶ್ರೀ  ಕೆ.ಆರ್.ಎಸ್. ಟಿ, ವೊಂಟಿಮಿಟ್ಟ)\",\r\n\t\t\"Spl Kalyanotsavam (Sri KVST, Narayanavanam)\": \"ಸ್ಪ್ಲಾಪ್ ಕಲ್ಯಾಣೋತ್ಸವಂ (ಶ್ರೀ ಕೆ.ವಿ.ಎಸ್.ಟಿ, ನಾರಾಯಣವನಂ\",\r\n\t\t\"Abhishekam to Sri Kalyana Venkateswara Swamy Varu (Sri KVST, Narayanavanam)\": \"ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರ ಸ್ವಾಮಿ ವರನಿಗೆ ಅಭಿಷೇಕ (ಶ್ರೀ ಕೆ.ವಿ.ಎಸ್.ಟಿ, ನಾರಾಯಣವನಂ\",\r\n\t\t\"Kalyanotsavam (Sri KVST, Narayanavanam)\": \"ಕಲ್ಯಾಣೋತ್ಸವ (ಶ್ರೀ ಕೆ.ವಿ.ಎಸ್.ಟಿ, ನಾರಾಯಣವನಂ\",\r\n\t\t\"Abhishekam to Sri Padmavathi Ammavaru (Sri KVST, Narayanavanam)\": \"ಶ್ರೀ ಪದ್ಮಾವತಿ ಅಮ್ಮನಿಗೆ ಅಭಿಷೇಕ (ಶ್ರೀ ಕೆ.ವಿ.ಎಸ್.ಟಿ, ನಾರಾಯಣವನಂ\",\r\n\t\t\"Kalyanotsavam (Sri VST, Nagalapuram)\": \"ಕಲ್ಯಾಣೋತ್ಸವ (ಶ್ರೀ ವಿಎಸ್ಟಿ, ನಾಗಲಾಪುರಂ\",\r\n\t\t\"Spl Kalyanotsavam (Sri VST, Nagalapuram)\": \"ಸ್ಪ್ಲಾಪ್ ಕಲ್ಯಾಣೋತ್ಸವ (ಶ್ರೀ ವಿಎಸ್ಟಿ, ನಾಗಲಾಪುರಂ)\",\r\n\t\t\"Abhishekam to Sri Vedanarayana swamy Varu (Sri VST, Nagalapuram)\": \"ಶ್ರೀ ವೇದನಾರಾಯಣ ಸ್ವಾಮಿ ವರು (ಶ್ರೀ ವಿಎಸ್ಟಿ, ನಾಗಲಾಪುರಂಗೆ ಅಭಿಷೇಕ್\",\r\n\t\t\"Abhishekam to Sri Hyagreeva Swamy (Sri VST, Nagalapuram)\": \"ಶ್ರೀ ಹಯಗ್ರೀವ ಸ್ವಾಮಿ ಅಭಿಷೇಕ (ಶ್ರೀ ವಿಎಸ್ಟಿ, ನಾಗಲಾಪುರಂ\",\r\n\t\t\"Ashtothara Satha Kalasabhishekam (Sri KRT, Tirupati)\": \"ಅಷ್ಟೋ ಉತ್ತರ ಶತ ಕಳಶಭಿಷೇಕ ಶ್ರೀ ಕೆಆರ್ಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Abhishekam (Sri KRT, Tirupati)\": \"ಅಭಿಷೇಕ   (ಶ್ರೀ ಕೆಆರ್ಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Sahasra Kalasabhishekam (Sri KRT, Tirupati)\": \"ಸಹಸ್ರ ಕಳಶಭಿಷೇಕ (ಶ್ರೀ ಕೆಆರ್ಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Kalyanotsavam (Sri KRT, Tirupati)\": \"ಕಲ್ಯಾಣೋತ್ಸವ (ಶ್ರೀ ಕೆಆರ್ಟಿ, ತಿರುಪತಿ)\",\r\n\t\t\"Mahanyasapurvaka Rudrabhishekam (Sri KT, Tirupati)\": \"Mahanyasapurvaka Rudrabhishekam (Sri KT, Tirupati)\",\r\n\t\t\"Siva Parvathula Kalyanotsavam (Sri KT, Tirupati)\": \"Siva Parvathula Kalyanotsavam (Sri KT, Tirupati)\",\r\n\t\t\"Rudrabhishekam-Masasivarathri (Sri KT, Tirupati)\":\"Rudrabhishekam-Masasivarathri (Sri KT, Tirupati)\",\r\n\t\t\"Rudrabhishekam-Evening (Sri KT, Tirupati)\":\"Rudrabhishekam-Evening (Sri KT, Tirupati)\",\r\n\t\t\"Rudrabhishekam-Morning (Sri KT, Tirupati)\":\"Rudrabhishekam-Morning (Sri KT, Tirupati)\",\r\n\t\t\"1.The reporting point for availing Seva is In front of the temple\": \"1. ಸೇವೆಯನ್ನು  ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವು ದೇವಾಲಯದ ಮುಂಭಾಗದಲ್ಲಿದೆ.\",\r\n\t\t\"1.The reporting point for availing Seva is near to the office inside the temple\": \" 1.ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವು ದೇವಸ್ಥಾನದ ಒಳಗಿನ  ಕಚೇರಿಯ ಹತ್ತಿರದಲ್ಲಿದೆ \",\r\n\t\t\"1.The reporting point for availing Seva is In front of Ammavari Koneru, SuryaNarayanaswamy Temple\": \"1.ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವು ಸೂರ್ಯನಾರಾಯಣಸ್ವಾಮಿ ದೇವಾಲಯದ ಎದುರುಗಿರುವ  ಅಮಮಾವರಿ ತೀರ್ಥದ ಬಿಳಿ ಇದೆ.\",\r\n\t\t\"1.The reporting point for availing Seva is Back side of Z.P High school, Srinivasa temple\": \"1.ಸೇವೆಯನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವು ಶ್ರೀನಿವಾಸ ದೇವಸ್ಥಾನದ ಹತ್ತಿರವಿರುವ  ಜೆಡ್.ಪಿ  ಪ್ರೌಢಶಾಲೆ  ಹಿಂಬಾದಿಯಲ್ಲಿದೆ.\",\r\n\t\t\"1.The reporting point for availing Seva is Inside the SriKalyanaVenkateswaraSwamy Temple,SrinivasaMangapuram\": \"1.ಸೇವಾವನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವೆಂದರೆ ಶ್ರೀಕಾಲಿಯಾನಾವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kodanda Rama Swamy Temple, Vontimitta\": \"1.ಸೇವೆ ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳ ಶ್ರೀ ಕೊಧಂಡ ರಾಮಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ವೊಂಟಿಮಿಟ್ಟ.\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kalyana Venkateswara Temple, Narayanavanam\": \"1.ಸೇವಾವನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವೆಂದರೆ   ಶ್ರೀ ಕಲ್ಯಣ  ವೆಂಕಟೇಶ್ವರ ದೇವಸ್ಥಾನ ನಾರಾಯಣವನಂ\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kodanda Rama Swamy Temple, Tirupati\": \"1.ಸೇವಾವನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವೆಂದರೆ   ಶ್ರೀ ಕೊಧಂಡ ರಾಮ ಸ್ವಾಮಿ ದೇವಾಲಯ, ತಿರುಪತಿ\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Vedanarayana Swamy Temple, Nagalapuram\": \"1.ಸೇವಾವನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವರದಿ ಮಾಡುವ ಸ್ಥಳವೆಂದರೆ   ಶ್ರೀ ವೇದಾನಾರಾಯಣ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ನಾಗಲಾಪುರಂ\",\r\n\r\n\t\t\"PAT-Seva\": \"PAT-ಸೇವೆ\",\r\n\t\t\"SGT-Seva\": \"SGT-ಸೇವೆ\",\r\n\t\t\"Sri PVST-Seva\": \"ಶ್ರೀ PVST-ಸೇವೆ\",\r\n\t\t\"Sri SNT-Seva\": \"ಶ್ರೀ SNT-ಸೇವೆ \",\r\n\t\t\"SVT-Seva\": \"SVT-ಸೇವೆ\",\r\n\t\t\"SKVST-Seva\": \"SKVST-ಸೇವೆ\",\r\n\t\t\"SKRST,Vontimitta-Seva\": \"SKRST,ವೊಂಟಿಮಿಟ್ಟ-ಸೇವೆ\",\r\n\t\t\"KRT,Tirupathi\": \"KRT,ತಿರುಪತಿ\",\r\n\t\t\"KVST,Narayanavanam\": \"KVST,ನಾರಾಯಣವನಂ\",\r\n\t\t\"VST,Nagalapuram\": \"VST,ನಾಗಲಾಪುರಂ\",\r\n\t\t\"HeaderPage.sgtreportAt\": \"In front of the temple,Tirupathi\",\r\n\t\t\"HeaderPage.pvstreportAt\": \"Near to the office inside the temple\",\r\n\t\t\"HeaderPage.sntreportAt\": \"In front of Ammavari Koneru, SuryaNarayanaswamy Temple\",\r\n\t\t\"HeaderPage.srvtreportAt\": \"Back side of Z.P High school, Srinivasa temple\",\r\n\t\t\"HeaderPage.skvstreportAt\": \"Inside the SriKalyanaVenkateswaraSwamy Temple,SrinivasaMangapuram\",\r\n\t\t\"HeaderPage.srivari\": \"ಶ್ರೀವಾರಿ ಸೇವಾ ತಿರುಮುಲಾ\",\r\n\t\t\"HeaderPage.sripat\": \"ಶ್ರೀ PAT ತಿರುಚುನೂರ್ ಸೇವಾ\",\r\n\t\t\"HeaderPage.srisgt\": \"ಶ್ರೀ ಗೋವಿಂದರಾಜ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನ\",\r\n\t\t\"HeaderPage.srispvs\": \"ಶ್ರೀ ಪ್ರಸನ್ನ ವೆಂಕಟೇಶ್ವರ ಸ್ವಾಮಿ ದೇವಾಲಯ\",\r\n\t\t\"HeaderPage.srisns\": \"ಸೂರ್ಯ ನಾರಾಯಣ ಸ್ವಾಮಿ ದೇವಾಲಯ,ತಿರುಚಾನೂರು\",\r\n\t\t\"HeaderPage.sristt\": \"ಶ್ರೀನಿವಾಸ ದೇವಸ್ಥಾನ, ತಿರುಚಾನೂರು\",\r\n\t\t\"HeaderPage.sriskvst\": \" ಶ್ರೀ ಕಲ್ಯಾಣ ವೆಂಕಟೇಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಶ್ರೀನಿವಾಸಮಂಗಾಪುರ\",\r\n\t\t\"HeaderPage.srivkst\": \"ಶ್ರೀ ಕೊಧಂಡ ರಾಮಸ್ವಾಮಿ ದೇವಾಲಯ, ವೊಂಟಿಮಿಟ್ಟ\",\r\n\t\t\"HeaderPage.srikvst\": \"ಶ್ರೀ ಕಲ್ಯಣ  ವೆಂಕಟೇಶ್ವರ ದೇವಸ್ಥಾನ ನಾರಾಯಣವನಂ\",\r\n\t\t\"HeaderPage.srivst\": \"ಶ್ರೀ ವೇದಾನಾರಾಯಣ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ನಾಗಲಾಪುರಂ\",\r\n\t\t\"HeaderPage.srikrt\": \"ಶ್ರೀ ಕೊಧಂಡ ರಾಮ ಸ್ವಾಮಿ ದೇವಾಲಯ, ತಿರುಪತಿ\",\r\n\t\t\"HeaderPage.srikt\": \"Sri Kapileswara Swamy Vari Temple, Tirupati\",\r\n\t\t\"Padmavathi Nilayam Rest House, Tiruchanoor\": \"ಪದ್ಮಾವತಿ ನಿಲಯ  ವಿಶ್ರಾಂತಿ ಕೊಠಡಿ, ತಿರುಚನೂರು\",\r\n\t\t\"Thollappa gardens, Tiruchanoor\": \"ಥೋಲ್ಲಪ್ಪ  ಗಾರ್ಡನ್ಸ್, ತಿರುಚನೂರ್ \"\r\n\r\n\r\n\t},\r\n\r\n\t\"Telugu\": {\r\n\r\n\t\t\"FooterPage.copyright\": \"కాపీ హక్కు\",\r\n\t\t\"FooterPage.rights\": \"తిరుమల తిరుపతి దేవస్థానములు - అన్ని హక్కులు సురక్షితము\",\r\n\t\t\"FooterPage.terms\": \"షరతులు నిబంధనలు\",\r\n\t\t\"FooterPage.guidelines\": \"మార్గదర్శకములు & తరచు అడుగు ప్రశ్నలు\",\r\n\t\t\"FooterPage.feedback\": \"ప్రతిస్పందన\",\r\n\t\t\"FooterPage.contactUs\": \"మమ్మల్ని సంప్రదించండి\",\r\n\t\t\"HeaderPage.welcome\": \"స్వాగతం,\",\r\n\t\t\"HeaderPage.logout\": \"లాగౌట్\",\r\n\t\t\"HeaderPage.lastLogin\": \"మీ గత లాగిన్\",\r\n\t\t\"HeaderPage.myAccount\": \"నా ఖాతా\",\r\n\t\t\"HeaderPage.sed\": \"ప్రత్యేక ప్రవేశ దర్శనము\",\r\n\t\t\"HeaderPage.accom\": \"వసతి\",\r\n\t\t\"HeaderPage.seva\": \"సేవ\",\r\n\t\t\"HeaderPage.sevaDIP\": \"సేవ ఎలక్ట్రానిక్ DIP\",\r\n\t\t\"HeaderPage.kalyanaVedika\": \"కళ్యాణ వేదిక\",\r\n\t\t\"HeaderPage.publications\": \"ప్రచురణలు\",\r\n\t\t\"HeaderPage.sapthagiri\": \"సప్తగిరి పత్రిక\",\r\n\t\t\"HeaderPage.eBooks\": \"e-పుస్తకములు\",\r\n\t\t\"HeaderPage.hundi\": \"హుండి\",\r\n\t\t\"HeaderPage.donation\": \"విరాళములు\",\r\n\t\t\"HeaderPage.donorManagementSystem\": \"(దాతల విరాళముల  నిర్వహణ వ్యవస్థ)\",\r\n\t\t\"HeaderPage.cottageDonors\": \"కాటేజీ దాతలు\",\r\n\t\t\"HeaderPage.cdms\": \"(కాటేజీ దాతల నిర్వహణ వ్యవస్థ)\",\r\n\t\t\"HeaderPage.dms\": \"దాతల విభాగ నిర్వహణ వ్యవస్థ\",\r\n\t\t\"HeaderPage.darshanDIP\": \"దర్శన ఎలక్ట్రానిక్ DIP\",\r\n\t\t\"HeaderPage.transactionHistory\": \"లావాదేవీల వివరములు\",\r\n\t\t\"HeaderPage.logIn\": \"లాగిన్\",\r\n\t\t\"Services\": \"సేవలు\",\r\n\t\t\"Special Entry Darshan\": \"ప్రత్యేక ప్రవేశ దర్శనము\",\r\n\t\t\"Darshan History\": \"దర్శన చరిత్ర\",\r\n\t\t\"Seva\": \"సేవ\",\r\n\t\t\"Seva_History\": \"సేవ చరిత్ర\",\r\n\t\t\"Kalyana Vedika\": \"కళ్యాణ వేదిక\",\r\n\t\t\"Kalyana Vedika Bookings\": \"కళ్యాణ వేదిక నమోదులు\",\r\n\t\t\"Reset Password\": \"పాస్ వర్ర్డ్ ను మార్చుకోండి\",\r\n\t\t\"Accommodation\": \"వసతి\",\r\n\t\t\"User Registration\": \"వినియోగదారుని నమోదు\",\r\n\t\t\"Sapthagiri_Magazine\": \"సప్తగిరి పత్రిక\",\r\n\t\t\"Accommodation History\": \"వసతి  చరిత్ర\",\r\n\t\t\"Hundi\": \"హుండి\",\r\n\t\t\"Hundi_History\": \"హుండి చరిత్ర\",\r\n\t\t\"Sapthagiri_History\": \"సప్తగిరి చరిత్ర\",\r\n\t\t\"Account Activation\": \"ఖాతా క్రియాశీలము\",\r\n\t\t\"Seva Electronic DIP History\": \"సేవ ఎలక్ట్రానిక్ DIP చరిత్ర\",\r\n\t\t\"SessionSeconds\": \"సెకన్లు\",\r\n\t\t\"SessionOk\": \"సరే\",\r\n\t\t\"SessionEnabtime\": \"మీ సెషన్ తదుపరి దశలో ముగుస్తుంది\",\r\n\t\t\"feedbackFormPage.feedbackForm\": \"ప్రతిస్పందన పత్రము\",\r\n\t\t\"feedbackFormPage.name\": \"పేరు\",\r\n\t\t\"feedbackFormPage.nameValidation\": \"పేరును సరిగా నమోదు చేయండి.  గరిష్టముగా 80 అక్షరములు మాత్రమె అనుమతించ బడును.\",\r\n\t\t\"feedbackFormPage.validName\": \"పేరును సరిగా నమోదు చేయండి.\",\r\n\t\t\"feedbackFormPage.emailId\": \"ఈ-మెయిల్ చిరునామా\",\r\n\t\t\"feedbackFormPage.validEmailId\": \"ఈ-మెయిల్ చిరునామా సరిగా నమోదు చేయండి\",\r\n\t\t\"feedbackFormPage.regProcess\": \"నమోదు ప్రక్రియ\",\r\n\t\t\"feedbackFormPage.delighted\": \"చాలా సంతోషముగా ఉన్నది\",\r\n\t\t\"feedbackFormPage.satisfied\": \"సంతృప్తికరముగా ఉన్నది\",\r\n\t\t\"feedbackFormPage.notSatisfied\": \"సంతృప్తికరముగా లేదు\",\r\n\t\t\"feedbackFormPage.bookingProcess\": \"బుకింగ్ / నమోదు ప్రక్రియ\",\r\n\t\t\"feedbackFormPage.redemption\": \"(వాపసు/రిడంప్షన్ ప్రక్రియ)\",\r\n\t\t\"feedbackFormPage.paymentExp\": \"చెల్లింపుకు సంబంధిచిన అనుభవములు\",\r\n\t\t\"feedbackFormPage.privRedemption\": \"ప్రివిలెజ్ రిడంప్షన్\",\r\n\t\t\"feedbackFormPage.commChannel\": \"సమాచార మాధ్యమములు (sms, ఈ-మెయిల్)\",\r\n\t\t\"feedbackFormPage.overallWebsiteExp\": \"మొత్తం వెబ్ సైట్ పై మీ అనుభవం\",\r\n\t\t\"feedbackFormPage.suggestions\": \"సలహాలు\",\r\n\t\t\"feedbackFormPage.validSuggestion\": \"మీ సలహాలను నమోదు చేయండి 1000 అక్షరములు మాత్రం అనుమతించబడును.\",\r\n\t\t\"feedbackFormPage.reset\": \"తాజాగా నమోదు చేయండి\",\r\n\t\t\"feedbackFormPage.submit\": \"సమర్పించండి\",\r\n\t\t\"My Account\": \"నా ఖాతా\",\r\n\t\t\"January\": \"జనవరి\",\r\n\t\t\"February\": \"ఫిబ్రవరి\",\r\n\t\t\"March\": \"మార్చి\",\r\n\t\t\"April\": \"ఏప్రిల్\",\r\n\t\t\"May\": \"మే\",\r\n\t\t\"June\": \"జూన్\",\r\n\t\t\"July\": \"జూలై\",\r\n\t\t\"August\": \"ఆగస్టు\",\r\n\t\t\"September\": \"సెప్టెంబర్\",\r\n\t\t\"October\": \"అక్టోబర్\",\r\n\t\t\"November\": \"నవంబర్\",\r\n\t\t\"December\": \"డిసెంబర్\",\r\n\t\t\"Seva Electronic DIP\": \"సేవ ఎలక్ట్రానిక్ DIP\",\r\n\t\t\"Seva DIP Result\": \"సేవ ఎలక్ట్రానిక్ DIP ఫలితము\",\r\n\t\t\"mon\": \"సోమ\",\r\n\t\t\"tue\": \"మం\",\r\n\t\t\"wed\": \"బుధ\",\r\n\t\t\"thu\": \"గురు\",\r\n\t\t\"fri\": \"శుక్ర\",\r\n\t\t\"sat\": \"శని\",\r\n\t\t\"sun\": \"ఆది\",\r\n\t\t\"ATC CAR PARKING AREA\": \"ఎటిసి కార్ పార్కింగ్ ఏరియా\",\r\n\t\t\"ATC Circle\": \"ATC Circle\",\r\n\t\t\"ATC Circle, Tirumala\": \"ATC Circle, Tirumala\",\r\n\t\t\"Archanananthara Darshanam\": \"అర్చనానంతర దర్శనం\",\r\n\t\t\"Prathyeka Kalyanotsavam\": \"ప్రత్యేక కళ్యానోత్సవం\",\r\n\t\t\"Suprabhatam\": \"సుప్రభాతం\",\r\n\t\t\"Nijapada Darshanam\": \"నిజపాద దర్శనం\",\r\n\t\t\"Thomala Seva\": \"తోమాల సేవ\",\r\n\t\t\"Archana\": \"అర్చన\",\r\n\t\t\"Visesha Pooja\": \"విశేష పూజ\",\r\n\t\t\"Astadala Pada Padmaradhanamu\": \"అష్టదళ పాద పద్మారాధనము\",\r\n\t\t\"Sahasra Kalasabhishekam\": \"సహస్ర కలశాభిషేకం\",\r\n\t\t\"Tiruppavadai\": \"తిరుప్పావడై\",\r\n\t\t\"Kalyanotsavam\": \"కళ్యానోత్సవం\",\r\n\t\t\"Abhishekam to Sri Vedavalli Ammavaru (Sri VST, Nagalapuram)\":\"శ్రీ వేదవల్లి అమ్మవారికి (శ్రీ VST, నాగలాపురం) అభిషేకం\",\r\n\t\t\"Vasanthotsavam\": \"వసంతోత్సవం\",\r\n\t\t\"Unjal Seva\": \"ఊంజల్ సేవ\",\r\n\t\t\"Sahasra Deepalankara Seva\": \"సహస్ర దీపాలంకార సేవ\",\r\n\t\t\"Arjitha Brahmotsavam\": \"ఆర్జిత బ్రహ్మోత్సవం\",\r\n\t\t\"Varalakshmi Vratham (Sri PAT, Tiruchanoor)\": \"వరలక్ష్మి వ్రతం (శ్రీ  PAT, తిరుచానూరు)\",\r\n\t\t\"Pavithrotsavam\":\"Pavithrotsavam\",\r\n\t\t\"PAN CARD\": \"పాన్ కార్డు\",\r\n\t\t\"RATION CARD\": \"రేషన్ కార్డు\",\r\n\t\t\"PASSPORT ID\": \"పాస్ పోర్టు గుర్తింపు\",\r\n\t\t\"DRIVING LICENSE\": \"డ్రైవింగ్ లైసెన్స్\",\r\n\t\t\"AADHAR CARD\": \"ఆధార్ కార్డు\",\r\n\t\t\"AadharCard\": \"ఆధార్ కార్డు\",\r\n\t\t\"VOTER ID\": \"ఓటరు గుర్తింపు\",\r\n\t\t\"Supatham Entry\": \"సుపథం ఎంట్రీ\",\r\n\t\t\"Vaibhavotsava Mandapam\": \"వైభవోత్సవ మండపం\",\r\n\t\t\"S.D. Mandapam\": \"ఎస్.డి. మండపం\",\r\n\t\t\"VQC-1\": \"వైకుంఠం క్యూ కాంప్లెక్స్-1\",\r\n\t\t\"Arjitha Kalyanotsavam (Sri Chennakesava Swamy Temple, Tallapaka)\": \"Arjitha Kalyanotsavam (Sri Chennakesava Swamy Temple, Tallapaka)\",\r\n\t\t\"Asthana Mandapam, besides Sri PAT, Tiruchanoor\": \"ఆస్తాన మండపం, శ్రీ  PAT పక్కన, తిరుచానూరు\",\r\n\t\t\"1. The reporting point for availing Seva is at Vaibhavotsava Mandapam, Tirumala.\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం - వైభవోత్సవ మండపం తిరుమల.\",\r\n\t\t\"1. The reporting point for availing Seva is at Supatham Entry, Tirumala.\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం - సుపథం ఎంట్రీ తిరుమల.\",\r\n\t\t\"1. The reporting point for availing Seva is at S.D. Mandapam, Tirumala.\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం - ఎస్.డి. మండపం తిరుమల.\",\r\n\t\t\"1. The reporting point for availing Seva is at VQC-1, Tirumala.\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం - వైకుంఠం క్యూ కాంప్లెక్స్-1 తిరుమల.\",\r\n\t\t\"1. The reporting point for availing Seva is at Asthana Mandapam, besides Sri PAT, Tiruchanoor.\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం -  ఆస్తాన మండపం, శ్రీ  PAT  పక్కన, తిరుచానూరు.\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kapileswara Swamy Vari Temple, Tirupati\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం -  శ్రీ కపిలేస్వర స్వామి వారి టెంపుల్, తిరుపతి\",\r\n\t\t\"1. The reporting point for availing Seva is at Sri Chennakesava Swamy Temple Office , Tallapaka.\":\"1. The reporting point for availing Seva is at Sri Chennakesava Swamy Temple Office , Tallapaka.\",\r\n\t\t\"2 Small Laddus\": \"2 చిన్న లడ్డూలు\",\r\n\t\t\"Male\": \"పురుషుడు\",\r\n\t\t\"Female\": \"స్త్రీ\",\r\n\t\t\"M\": \"పురుషుడు\",\r\n\t\t\"F\": \"స్త్రీ\",\r\n\t\t\"Tirumala\": \"తిరుమల\",\r\n\t\t\"Tirupati\": \"తిరుపతి\",\r\n\t\t\"Srinivasam\": \"శ్రీనివాసం\",\r\n\t\t\"Madhavam\": \"మాధవం\",\r\n\t\t\"Vishnu Nivasam\": \"విష్ణు నివాసం \",\r\n\t\t\"Donation\": \"విరాళములు\",\r\n\t\t\"Diaries/Calendars/Panchangam\": \"డైరీలు / క్యాలెండర్లు / పంచాంగం\",\r\n\t\t\"Suprabhatham (Sri PAT, Tiruchanoor)\": \" సుప్రభాతం (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Kalyanotsavam (Sri PAT, Tiruchanoor)\": \"కల్యాణోత్సవం (శ్రీ PAT తిరుచనూర్) \",\r\n\t\t\"Sri Chennakesava Swamy Temple Office\": \"Sri Chennakesava Swamy Temple Office\",\r\n\t\t\"Astadala Pada Padmaradhanam (Sri PAT, Tiruchanoor)\": \"అష్టదళ పాద పద్మారాధనము (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Tiruppavada (Sri PAT, Tiruchanoor)\": \"తిరుప్పావడై (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Vastralankara Seva (Sri PAT, Tiruchanoor)\": \"వస్త్రాలంకర సేవ  (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Abhishekam (Sri PAT, Tiruchanoor)\": \"అభిషేకం  (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Lakshmi Puja (Sri PAT, Tiruchanoor)\": \"లక్ష్మి పూజ (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Pushpanjali Seva (Sri PAT, Tiruchanoor)\": \"పుష్పాంజలి సేవ (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"Astothara Satakalasabhishekam (Sri PAT, Tiruchanoor)\": \"అష్టొత్తర శతకలాశాభిషేకం (శ్రీ PAT తిరుచనూర్)\",\r\n\t\t\"In front of the temple, Tiruchanoor\": \"ఆలయం ముందు ,తిరుచనూర్ .\",\r\n\t\t\"1. The reporting point for availing Seva is at In front of the temple, Tiruchanoor.\": \"1. సేవను వినియోగించుకోవటానికి హాజరు కావలసిన ప్రదేశం - ఆలయం ముందు ,తిరుచనూర్ .\",\r\n\t\t\"Suprabhatham (Sri GT, Tirupathi)\": \"సుప్రభాతం ( శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Thomala Seva (Sri GT, Tirupathi)\": \"తోమాల సేవ ( శ్రీ  జి.టి, తిరుపతి)\",\r\n\t\t\"Sahasranama Archana (Sri GT, Tirupathi)\": \"సహస్రనామా అర్చన ( శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Archana Anantha Darshana (Sri GT, Tirupathi)\": \"అర్చన అనంత దర్శన ( శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Ekanta Seva (Sri GT, Tirupathi)\": \"ఏకంత సేవా ( శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Unjal Seva (Sri GT, Tirupathi)\": \"ఉంజల్ సేవ ( శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Unjal Seva (Uttra Nakshatram, Sri GT, Tirupathi)\": \"ఉంజల్ సేవ (ఉత్త్ర నక్షత్రం, శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Unjal Seva (Rohini Nakshatram, Sri GT, Tirupathi)\": \"ఉంజల్ సేవ (రోహిని నక్షత్రం, శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Unjal Seva (Sravana Nakshatram, Sri GT, Tirupathi)\": \"ఉంజల్ సేవ ( శ్రవన నక్షత్రం, శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Pavithrotsavam (Sri GT, Tirupathi)\": \"పవిత్రోత్సవం ( శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Pushpayagam (Sri GT, Tirupathi)\": \"పుష్పయాగం (  శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Vahana Seva(Morning Brahmotsavams, Sri GT, Tirupathi)\": \"వాహన సేవ ( ఉదయ భ్రహ్మొత్సవం, శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Vahana Seva(Evening Brahmotsavams, Sri GT, Tirupathi)\": \"వాహన సేవ (  సాయంత్ర భ్రహ్మొత్సవం, శ్రీ జి.టి, తిరుపతి)\",\r\n\t\t\"Vastralankarana Seva (Sri P.V.S.T,Appalayagunta)\": \"వస్త్రాలంకరణ సేవ ( శ్రీ పి.వి.యస్.టి,అప్పలయగుంట)\",\r\n\t\t\"Abhishekam to Moolavarlu (Sri P.V.S.T,Appalayagunta)\": \"మూలవర్లు కి అభిషేకం ( శ్రీ పి.వి.యస్.టి,అప్పలయగుంట)\",\r\n\t\t\"Kalyanotsavam (Sri P.V.S.T,Appalayagunta)\": \"కళ్యానోత్సవం ( శ్రీ పి.వి.యస్.టి,అప్పలయగుంట)\",\r\n\t\t\"Astadala Pada Padmaradhana (Sri P.V.S.T,Appalayagunta)\": \"అస్టదల పద పద్మారాధన ( శ్రీ పి.వి.యస్.టి,అప్పలయగుంట)\",\r\n\t\t\"Asthothara sata kalasabhishekam (Sri P.V.S.T,Appalayagunta)\": \"అస్ఠొథర సత ఖలసబిషేఖం ( శ్రీ పి.వి.యస్.టి,అప్పలయగుంట)\",\r\n\t\t\"Arjitha Kalyanotsavam (Brahmotsavams, Sri P.V.S.T,Appalayagunta)\": \"అర్జిథ కళ్యానోత్సవం ( భ్రహ్మొత్సవం, శ్రీ పి.వి.యస్.టి,అప్పలయగుంట)\",\r\n\t\t\"Abhishekam to Moolavarlu (Sri S.N.S.T, Tiruchanoor)\": \"మూలవర్లు కి అభిషేకం( శ్రీ యస్.ఎన్.యస్.టి, తిరుచనూర్)\",\r\n\t\t\"Abhishekam to Moolavarlu (Srinivasa Temple,Tiruchanoor)\": \"మూలవర్లు కి అభిషేకం (శ్రీనివాస టెంపుల్, తిరుచనూర్)\",\r\n\t\t\"Kalyana kankanam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"కళ్యాన కంకణం (   శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"kalyanotsavam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"కళ్యానోత్సవం (  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Veda Asirvachanam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"వేద అసిరవధం (  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Swarna Pushpaarchana (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"స్వర్న ఫుష్పార్చన ( శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Astothara Satha Kalasabishekam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"అస్టొథర శథ ఖలసాభిషేకం (  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Thiruppavada (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"తిరుప్పవద (   శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Abhishekam to Moolavaru (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"మూలవర్లు కి అభిషేకం ( శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Vasthralankara Seva (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"వస్థ్రాలంకార సేవ (  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Unjal Seva(Sravana Nakshatram, Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ఉంజల్ సేవ (శ్రవన నక్షత్రం,  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం )\",\r\n\t\t\"Unjal Seva(Pournami, Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"ఉంజల్ సేవ( పౌర్ణమి, శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం  )\",\r\n\t\t\"Pavithrotsavam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram)\": \"పవిత్రోత్సవం (  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం  )\",\r\n\t\t\"Vasantotsavam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram)\": \"వసంతోత్సవం  (  శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం  )\",\r\n\t\t\"Pushpayagam (Sri KalyanaVenkateswaraSwamy Temple,Srinivasamangapuram )\": \"పుష్పయాగం ( శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం)\",\r\n\t\t\"Abhisekham (Sri KRST, Vontimitta)\": \"అభిషేకం (శ్రీ కె.అర్.యస్.టి, ఒంటిమిట్ట)\",\r\n\t\t\"Kalyanotsavam (Sri KRST, Vontimitta)\": \"కళ్యానోత్సవం  (శ్రీ కె.అర్.యస్.టి, ఒంటిమిట్ట)\",\r\n\t\t\"Anthralaya Darshan (Sri KRST, Vontimitta)\": \"అంత్రాలయ దర్షన్ (శ్రీ కె.అర్.యస్.టి, ఒంటిమిట్ట)\",\r\n\t\t\"Archana Harathi (Sri KRST, Vontimitta)\": \"అర్చన హరతి (శ్రీ కె.అర్.యస్.టి, ఒంటిమిట్ట)\",\r\n\t\t\"Spl Kalyanotsavam (Sri KVST, Narayanavanam)\": \" ప్రత్యేక  కళ్యాణోత్సవం   (  శ్రీ  కె.వి.యస్.టి ,  నారాయనవనం )\",\r\n\t\t\"Abhishekam to Sri Kalyana Venkateswara Swamy Varu (Sri KVST, Narayanavanam)\": \"శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి   వారికి  అభిషేకం    (  శ్రీ  కె.వి.యస్.టి ,  నారాయనవనం )\",\r\n\t\t\"Kalyanotsavam (Sri KVST, Narayanavanam)\": \" కళ్యాణోత్సవం  (  శ్రీ  కె.వి.యస్.టి ,  నారాయనవనం )\",\r\n\t\t\"Abhishekam to Sri Padmavathi Ammavaru (Sri KVST, Narayanavanam)\": \"శ్రీ  పద్మావతి  అమ్మవారికి  అభిషేకం  (  శ్రీ  కె.వి.యస్.టి ,  నారాయనవనం )\",\r\n\t\t\"Kalyanotsavam (Sri VST, Nagalapuram)\": \"కళ్యాణోత్సవం   ( శ్రీ   వి.యస్.టి  నాగాలపురం)\",\r\n\t\t\"Spl Kalyanotsavam (Sri VST, Nagalapuram)\": \"ప్రత్యేక  కళ్యాణోత్సవం   ( శ్రీ   వి.యస్.టి  నాగాలపురం)\",\r\n\t\t\"Abhishekam to Sri Vedanarayana swamy Varu (Sri VST, Nagalapuram)\": \"శ్రీ  వేదనారాయన స్వామి వారికి  అభిషేకం ( శ్రీ   వి.యస్.టి  నాగాలపురం)\",\r\n\t\t\"Abhishekam to Sri Hyagreeva Swamy (Sri VST, Nagalapuram)\": \"హ్యగ్రీవ స్వామి వారికి  అభిషేకం ( శ్రీ   వి.యస్.టి  నాగాలపురం)\",\r\n\t\t\"Ashtothara Satha Kalasabhishekam (Sri KRT, Tirupati)\": \"అష్టొత్తర శతకలాశాభిషేకం  (  శ్రీ  కె.అర్.టి  తిరుపతి )\",\r\n\t\t\"Abhishekam (Sri KRT, Tirupati)\": \"అభిషేకం  (  శ్రీ  కె.అర్.టి  తిరుపతి )\",\r\n\t\t\"Sahasra Kalasabhishekam (Sri KRT, Tirupati)\": \"సహస్ర  ఖలసాభిషేకం  (  శ్రీ  కె.అర్.టి  తిరుపతి )\",\r\n\t\t\"Kalyanotsavam (Sri KRT, Tirupati)\": \" కళ్యాణోత్సవం  (  శ్రీ  కె.అర్.టి  తిరుపతి )\",\r\n\t\t\"Mahanyasapurvaka Rudrabhishekam (Sri KT, Tirupati)\": \"మహన్యాసపూర్వక రుద్రాభిషేకం (శ్రీ కె.టి, తిరుపతి)\",\r\n\t\t\"Siva Parvathula Kalyanotsavam (Sri KT, Tirupati)\": \"శివ పార్వతుల కళ్యానోత్సవం (శ్రీ కె.టి, తిరుపతి)\",\r\n\t\t\"Rudrabhishekam-Masasivarathri (Sri KT, Tirupati)\":\"రుద్రాభిషేకం -మాససివరాత్రి (శ్రీ కె.టి, తిరుపతి)\",\r\n\t\t\"Rudrabhishekam-Evening (Sri KT, Tirupati)\":\"రుద్రాభిషేకం-సాయంకాలము (శ్రీ కె.టి, తిరుపతి)\",\r\n\t\t\"Rudrabhishekam-Morning (Sri KT, Tirupati)\":\"రుద్రాభిషేకం-ఉదయం (శ్రీ కె.టి, తిరుపతి)\",\r\n\t\t\"1.The reporting point for availing Seva is In front of the temple\": \"1.సేవలను పొందటాని కి టెంపుల్ ముందు భాగము నందు హజరు కాగలరు.\",\r\n\t\t\"1.The reporting point for availing Seva is near to the office inside the temple\": \" 1.సేవలను పొందటాని కి టెంపుల్ లోపల ,సమీపములొ ఉన్న కార్యాలయమునందు హజరు కాగలరు.\",\r\n\t\t\"1.The reporting point for availing Seva is In front of Ammavari Koneru, SuryaNarayanaswamy Temple\": \"1.సేవను పొందటానికి అమ్మవారి కోనేరు, సూర్యనారాయనస్వామి టెంపుల్ నందు హజరు కాగలరు.\",\r\n\t\t\"1.The reporting point for availing Seva is Back side of Z.P High school, Srinivasa temple\": \"1.సేవను పొందటానికి ఝె.పి హై స్కూల్, శ్రీనివస టెంపుల్ వెనుక భాగము నందు హజరు కాగలరు.\",\r\n\t\t\"1.The reporting point for availing Seva is Inside the SriKalyanaVenkateswaraSwamy Temple,SrinivasaMangapuram\": \"1.సేవను వినియోగించుకొనుటకు,శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం లోపల హజరు కాగలరు.\",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kodanda Rama Swamy Temple, Vontimitta\": \"1..సేవను వినియోగించుకొనుటకు శ్రీ కోదండ రామ స్వామి టెంపుల్, ఒంటిమిట్ట దగ్గర హజరు కాగలరు. \",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kalyana Venkateswara Temple, Narayanavanam\": \"1.సేవను వినియోగించుకొనుటకు శ్రీ కళ్యాణవెంకటేశ్వర  టెంపుల్ నారాయనవనం  దగ్గర హజరు కాగలరు. \",\r\n\t\t\"1.The reporting point for availing Seva is Sri Kodanda Rama Swamy Temple, Tirupati\": \"1.సేవను వినియోగించుకొనుటకు శ్రీ  కోదండ రామ స్వామి టెంపుల్ , తిరుపతి దగ్గర హజరు కాగలరు. \",\r\n\t\t\"1.The reporting point for availing Seva is Sri Vedanarayana Swamy Temple, Nagalapuram\": \"1.సేవను వినియోగించుకొనుటకు శ్రీ  వేదనారాయన స్వామి టెంపుల్  నాగాలపురం దగ్గర హజరు కాగలరు. \",\r\n\t\t\"PAT-Seva\": \"PAT-సేవ\",\r\n\t\t\"SGT-Seva\": \"SGT-సేవ\",\r\n\t\t\"Sri PVST-Seva\": \"శ్రీ PVST-సేవ\",\r\n\t\t\"Sri SNT-Seva\": \"శ్రీ SNT-సేవ \",\r\n\t\t\"SVT-Seva\": \"SVT-సేవ\",\r\n\t\t\"SKVST-Seva\": \"SKVST-సేవ\",\r\n\t\t\"SKRST,Vontimitta-Seva\": \"SKRST,ఒంటిమిట్ట-సేవ\",\r\n\t\t\"KRT,Tirupathi\": \"KRT,తిరుపతి\",\r\n\t\t\"KVST,Narayanavanam\": \"KVST,నారాయనవనం\",\r\n\t\t\"VST,Nagalapuram\": \"VST,నాగాలపురం\",\r\n\t\t\"HeaderPage.sgtreportAt\": \"In front of the temple,Tirupathi\",\r\n\t\t\"HeaderPage.pvstreportAt\": \"Near to the office inside the temple\",\r\n\t\t\"HeaderPage.sntreportAt\": \"In front of Ammavari Koneru, SuryaNarayanaswamy Temple\",\r\n\t\t\"HeaderPage.srvtreportAt\": \"Back side of Z.P High school, Srinivasa temple\",\r\n\t\t\"HeaderPage.skvstreportAt\": \"Inside the SriKalyanaVenkateswaraSwamy Temple,SrinivasaMangapuram\",\r\n\t\t\"HeaderPage.srivari\": \"శ్రీవారి సేవ ,తిరుమల\",\r\n\t\t\"HeaderPage.sripat\": \"శ్రీ PAT తిరుచనూర్ సేవ\",\r\n\t\t\"HeaderPage.srisgt\": \"శ్రీ గోవిందరాజ స్వామి టెంపుల్\",\r\n\t\t\"HeaderPage.srispvs\": \"శ్రీ ప్రసన్న వెంకటేశ్వరా స్వామి టెంపుల్\",\r\n\t\t\"HeaderPage.srisns\": \"సూర్య నారాయణ స్వామి టెంపుల్,తిరుచనూర్\",\r\n\t\t\"HeaderPage.sristt\": \"శ్రీనివాస టెంపుల్,తిరుచనూర్\",\r\n\t\t\"HeaderPage.sriskvst\": \"శ్రీ కళ్యాణవెంకటేశ్వరా స్వామి టెంపుల్,శ్రీనివాసమంగాపురం  \",\r\n\t\t\"HeaderPage.srivkst\": \"శ్రీ కోదండ రామ స్వామి టెంపుల్, ఒంటిమిట్ట\",\r\n\t\t\"HeaderPage.srikvst\": \"శ్రీ కళ్యాణవెంకటేశ్వర  టెంపుల్ నారాయనవనం\",\r\n\t\t\"HeaderPage.srivst\": \"శ్రీ  వేదనారాయన స్వామి టెంపుల్  నాగాలపురం\",\r\n\t\t\"HeaderPage.srikrt\": \"శ్రీ  కోదండ రామ స్వామి టెంపుల్ , తిరుపతి\",\r\n\t\t\"HeaderPage.srikt\": \"శ్రీ కపిలేస్వర స్వామి వారి టెంపుల్, తిరుపతి\",\r\n\t\t\"Padmavathi Nilayam Rest House, Tiruchanoor\": \"పద్మావతి నిలయం విశ్రాంతి గృహం, తిరుచానూరు\",\r\n\t\t\"Thollappa gardens, Tiruchanoor\": \"తోల్లప్ప గార్డెన్స్ , తిరుచనూర్\"\r\n\r\n\t},\r\n\r\n\t\"English\": {\r\n\t\r\n\t\t\"Laksha Kumkumarchana,Tiruchanoor (Online Participation)\":\"Laksha Kumkumarchana,Tiruchanoor (Online Participation)\",\r\n\t\t\"Laksha Kumkumarchana,Tiruchanoor (Sri PAT, Tiruchanoor)\":\"Laksha Kumkumarchana,Tiruchanoor (Sri PAT, Tiruchanoor)\",\r\n\t\t\"FooterPage.copyright\": \"Copyright\",\r\n\t\t\"FooterPage.rights\": \"Tirumala Tirupati Devasthanams - All rights reserved\",\r\n\t\t\"FooterPage.terms\": \"Terms and Conditions\",\r\n\t\t\"FooterPage.guidelines\": \"Guidelines & FAQs\",\r\n\t\t\"FooterPage.feedback\": \"Feedback\",\r\n\t\t\"FooterPage.contactUs\": \"Contact Us\",\r\n\t\t\"HeaderPage.welcome\": \"Welcome,\",\r\n\t\t\"HeaderPage.logout\": \"Logout\",\r\n\t\t\"HeaderPage.lastLogin\": \"Your Last Login\",\r\n\t\t\"HeaderPage.myAccount\": \"My Account\",\r\n\t\t\"HeaderPage.sed\": \"Special Entry Darshan\",\r\n\t\t\"HeaderPage.accom\": \"Accommodation\",\r\n\t\t\"HeaderPage.seva\": \"Seva\",\r\n\t\t\"HeaderPage.sevaDIP\": \"Seva Electronic DIP\",\r\n\t\t\"HeaderPage.kalyanaVedika\": \"Kalyana Vedika\",\r\n\t\t\"HeaderPage.publications\": \"Publications\",\r\n\t\t\"HeaderPage.sapthagiri\": \"Sapthagiri Magazine\",\r\n\t\t\"HeaderPage.eBooks\": \"e-Books\",\r\n\t\t\"HeaderPage.hundi\": \"Hundi\",\r\n\t\t\"HeaderPage.donation\": \"Donation\",\r\n\t\t\"HeaderPage.donorManagementSystem\": \"(Donor Privileges)\",\r\n\t\t\"HeaderPage.cottageDonors\": \"Cottage Donors\",\r\n\t\t\"HeaderPage.cdms\": \"(Cottage Donor Management System)\",\r\n\t\t\"HeaderPage.dms\": \"Donor